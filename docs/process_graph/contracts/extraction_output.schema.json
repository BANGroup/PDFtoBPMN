{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "process_graph/extraction_output/0.1",
  "title": "Выход экстрактора графа процессов (v0.1, D-044)",
  "description": "Результат разбора одного документа СМК. Типы и атрибуты — schema/process_graph.schema.yaml. Каждый элемент обязан иметь evidence.",
  "type": "object",
  "required": ["schema_version", "document", "nodes", "edges", "gaps"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "0.1"},
    "document": {
      "type": "object",
      "required": ["code", "name"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "name": {"type": "string"},
        "version": {"type": ["string", "null"]}
      }
    },
    "nodes": {"type": "array", "items": {"$ref": "#/$defs/node"}},
    "edges": {"type": "array", "items": {"$ref": "#/$defs/edge"}},
    "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["document_code", "clause", "quote", "mode", "confidence"],
      "additionalProperties": false,
      "properties": {
        "document_code": {"type": "string"},
        "clause": {"type": "string"},
        "quote": {"type": "string", "minLength": 1},
        "mode": {"enum": ["explicit", "structural", "reference"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "name_original", "attributes", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["PROCESS", "TASK", "EVENT", "GATEWAY", "LINK", "ORG_UNIT", "DOCUMENT", "OBJECT", "DATA_STORE", "SOFTWARE", "EXTERNAL", "BUSINESS_RULE", "RISK", "KPI"]},
        "name_original": {"type": ["string", "null"]},
        "name_normalized": {"type": ["string", "null"]},
        "attributes": {"type": "object", "description": "атрибуты по schema/process_graph.schema.yaml; отсутствующее значение — null"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "edge": {
      "type": "object",
      "required": ["id", "type", "from", "to", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string"},
        "type": {"enum": ["FLOW", "PERFORMS", "CONTAINS", "OWNS", "PARTICIPATES", "INPUT", "OUTPUT", "STORED_IN", "SUPPORTED_BY", "MESSAGE", "REGULATED_BY", "IN_UNIT", "MEMBER_OF", "SUBORDINATE_TO", "RULE_FOR", "HAS_RISK", "MITIGATES", "MEASURED_BY", "MEASURES", "RESPONSIBLE_FOR_KPI", "SW_PART_OF"]},
        "from": {"type": "string"},
        "to": {"type": "string"},
        "attributes": {"type": "object"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      }
    },
    "gap": {
      "type": "object",
      "required": ["code", "marker", "element_id", "description"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "pattern": "^(C[1-7]|W([1-9]|10))$"},
        "marker": {"enum": ["⚠ GAP", "⊘ n/a", "≠ контекст", "→? обратное направление неизвестно"]},
        "element_id": {"type": ["string", "null"]},
        "description": {"type": "string"},
        "document_code": {"type": ["string", "null"]},
        "clause": {"type": ["string", "null"]},
        "quote": {"type": ["string", "null"]}
      }
    }
  }
}

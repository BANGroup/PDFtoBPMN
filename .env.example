# =============================================================================
# Environment Variables for PDFtoBPMN Project
# =============================================================================
# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
#
# ⚠️ НИКОГДА не добавляйте .env в git!
# =============================================================================

# -----------------------------------------------------------------------------
# HuggingFace
# -----------------------------------------------------------------------------
# Токен для ускоренной загрузки моделей
# Получить: https://huggingface.co/settings/tokens
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# -----------------------------------------------------------------------------
# OCR Services URLs (для удалённых сервисов)
# -----------------------------------------------------------------------------
# URL DeepSeek OCR сервиса (если запущен удалённо)
# DEEPSEEK_URL=http://localhost:8000

# URL Qwen VLM сервиса (если запущен удалённо)
# QWEN_REMOTE_URL=http://localhost:8001

# -----------------------------------------------------------------------------
# Model Configuration
# -----------------------------------------------------------------------------
# Модель Qwen (по умолчанию 2B для 16GB VRAM)
# QWEN_MODEL=Qwen/Qwen2-VL-2B-Instruct
# QWEN_MODEL=Qwen/Qwen2-VL-7B-Instruct  # Для 24GB+ VRAM

# Модель DeepSeek OCR
# DEEPSEEK_MODEL=deepseek-ai/DeepSeek-OCR

# Flash Attention (auto/true/false)
# USE_FLASH_ATTENTION=auto

# Максимум токенов в ответе
# MAX_NEW_TOKENS=2048

# -----------------------------------------------------------------------------
# GPU Configuration
# -----------------------------------------------------------------------------
# Видимые GPU (по умолчанию все)
# CUDA_VISIBLE_DEVICES=0

# PyTorch memory allocator
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# TASK-017: ночная сборка корпуса БНД (scripts/ingestion/bnd_sync)
# Отчёт — личными сообщениями от бота ДВК (Hermes, профиль mm) в Mattermost
MATTERMOST_URL=https://team.utair.io
MATTERMOST_TOKEN=
BND_REPORT_MM_USERS=budnik_an,lavrova_tv,bachurina_iv
BND_WEBBI_DIR=/home/budnik_an/todo/webBI

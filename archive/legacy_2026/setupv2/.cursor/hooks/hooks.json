{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python3 .cursor/hooks/check_handoff.py",
        "timeoutSec": 5
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python3 .cursor/hooks/block_orchestrator_code.py",
        "timeoutSec": 5
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 .cursor/hooks/check_ownership.py",
        "timeoutSec": 5
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/record_stop.py",
        "timeoutSec": 10
      }
    ]
  }
}

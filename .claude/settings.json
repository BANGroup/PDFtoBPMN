{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.cursor/hooks/safety_guard.py\" --claude",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
